{
  "reference": "docs/dental-reference/reference-aligner.stl",
  "defaults": {
    "h": 0.2,
    "t": 0.6,
    "m": 0.5,
    "aG": 1.2,
    "window": [24, 14],
    "windowOffset": [0, 0],
    "noise": 0,
    "jitter": true
  },
  "cases": [
    { "id": "B01", "tag": "upper-window", "mode": "B", "arch": "upper", "plate": true,
      "expected": "built; opening present; outer chain runs the whole loop including the back border and distal cuts" },
    { "id": "B02", "tag": "upper-no-plate", "mode": "B", "arch": "upper",
      "expected": "absent" },
    { "id": "B04", "tag": "upper-flat-trim", "mode": "B", "arch": "upper", "plate": true, "m": 2, "aG": 0,
      "expected": "built" },
    { "id": "B05", "tag": "upper-thick", "mode": "B", "arch": "upper", "plate": true, "t": 0.8, "h": 0.4,
      "expected": "built" },
    { "id": "B06", "tag": "upper-deep-scallop", "mode": "B", "arch": "upper", "plate": true, "m": -0.5, "aG": 1.5, "heldOut": true,
      "expected": "built (held out)" },
    { "id": "B07", "tag": "upper-rounded-trim", "mode": "B", "arch": "upper", "plate": true, "roundedTrim": true,
      "expected": "inconclusive with a named reason, never a wrong belt" },
    { "id": "B08", "tag": "upper-thin-fine", "mode": "B", "arch": "upper", "plate": true, "t": 0.5, "h": 0.12,
      "expected": "built" },
    { "id": "B09", "tag": "upper-wide", "mode": "B", "arch": "upper", "plate": true, "archW": 62, "archD": 48, "archWf": 34,
      "window": [20, 10], "windowOffset": [0, 5], "heldOut": true,
      "expected": "built (held out)" },
    { "id": "B10", "tag": "lower", "mode": "B", "arch": "lower",
      "expected": "absent" },
    { "id": "C02", "tag": "reference-mirror-scale-0.9", "mode": "C", "mirror": true, "scale": 0.9, "heldOut": true,
      "expected": "built (held out)" },
    { "id": "C03", "tag": "reference-noise-0.03", "mode": "C", "noise": 0.03,
      "expected": "built" },
    { "id": "C04", "tag": "reference-scale-1.15", "mode": "C", "scale": 1.15,
      "expected": "built" }
  ]
}
